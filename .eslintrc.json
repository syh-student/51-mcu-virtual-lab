{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "C51": "writable",
    "C51HW": "writable",
    "module": "writable",
    "require": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none", "caughtErrors": "none" }],
    "no-redeclare": "error",
    "no-dupe-keys": "error",
    "no-dupe-args": "error",
    "no-unreachable": "error",
    "no-cond-assign": ["error", "except-parens"],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-fallthrough": "error",
    "eqeqeq": "off",
    "no-console": "off"
  }
}
